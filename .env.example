NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Supabase Project URL (HTTPS URL, not a PostgreSQL connection string)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Publishable key is preferred for login. Legacy anon keys are also supported.
# Optional backend-only alternative: SUPABASE_SECRET_KEY (never expose in frontend).

# Google AI Studio API key; keep on the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
