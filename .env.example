NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Supabase Connect -> Session pooler URI. Replace password locally, URL-encoded.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=verify-full
# Optional: path to the downloaded Supabase database CA certificate.
# DATABASE_CA_FILE=certs/prod-ca.crt

# Generate a random secret of at least 32 bytes. Never expose it to FE.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRES_IN=1h

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
